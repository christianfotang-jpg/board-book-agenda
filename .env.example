# Copy to .env and fill in. The Anthropic SDK also accepts credentials via
# `ant auth login` (no key needed here) - see the README for details.
ANTHROPIC_API_KEY=

# Optional overrides (defaults shown)
BOARDBOOK_MODEL=claude-opus-5
BOARDBOOK_DEFAULT_INSTITUTION=University of Alberta
BOARDBOOK_UPLOAD_DIR=./uploads
BOARDBOOK_OUTPUT_DIR=./output
